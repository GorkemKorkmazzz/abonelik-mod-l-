# --- Sunucu ---
PORT=3000
# Modülün internetten erişilen adresi (widget ve mail linkleri bunu kullanır)
PUBLIC_URL=https://abonelik.ornekmagaza.com
ADMIN_PASSWORD=guclu-bir-sifre
SCHEDULER_MINUTES=15

# --- ikas private app (Ayarlar > Uygulamalar > Özel uygulama oluştur) ---
IKAS_STORE_NAME=magazaadi
IKAS_CLIENT_ID=
IKAS_CLIENT_SECRET=
# ikas'a bağlanmadan denemek için:
# IKAS_MOCK=1

# --- Mail ---
# smtp: sipariş maili dahil tüm mailleri modül gönderir
# ikas: sipariş maili ikas'a bırakılır, modül sadece hoş geldin/hatırlatma/iptal gönderir
MAIL_MODE=smtp
# Brevo: Ayarlar > SMTP & API > SMTP. SMTP_USER = Brevo "Login", SMTP_PASS = SMTP anahtarı
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mağaza <siparis@ornekmagaza.com>"
# Sipariş oluşturma hatalarında bilgilendirilecek adres
ADMIN_EMAIL=
